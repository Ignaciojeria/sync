package ui

templ HomePage() {
	<div class="space-y-6">
		<section class="hero rounded-[2rem] border border-base-300/70 bg-base-100/80 shadow-[var(--pi-shadow-card)] backdrop-blur overflow-hidden">
			<div class="hero-content w-full max-w-none flex-col gap-8 px-6 py-7 lg:px-9 lg:py-9">
				<div class="grid w-full gap-6 lg:grid-cols-[1.15fr_0.85fr] lg:items-end">
					<div class="max-w-2xl space-y-4">
						<div class="inline-flex items-baseline gap-1.5 text-[1.1rem] font-semibold leading-none tracking-[0.015em] text-base-content/82" style="font-family: var(--pi-font-label-family, var(--pi-font-body-family, Inter, system-ui, sans-serif));">
							<span class="sr-only">Sync 4 Run</span>
							<span>sync</span>
							<span><span class="text-primary text-[1.08em] font-medium tracking-[-0.08em]">4</span><span class="text-primary">.</span></span>
							<span>run</span>
						</div>
						<div class="space-y-3">
							<h1 class="text-3xl font-bold tracking-tight lg:text-5xl">Tu workspace persistente para operar agentes.</h1>
							<p class="max-w-xl text-sm leading-7 opacity-72 lg:text-base">
								Desde aquí puedes entrar a la consola, revisar calidad, explorar jobs y ajustar el sistema visual activo.
							</p>
						</div>
						<div class="flex flex-wrap gap-3">
							<a class="btn btn-primary" href="/editor-view">Abrir consola</a>
							<a class="btn btn-ghost border border-base-300/70 bg-base-100/60" href="/design">Ver design system</a>
						</div>
					</div>
					<div class="grid gap-3 sm:grid-cols-2">
						<div class="rounded-[1.35rem] border border-base-300/70 bg-[var(--pi-surface-elevated)] p-4 shadow-[var(--pi-shadow-card-soft)]">
							<div class="text-[11px] uppercase tracking-[0.22em] opacity-55">Workspace</div>
							<div class="mt-2 text-lg font-semibold">App unificada</div>
							<p class="mt-1 text-sm leading-6 opacity-70">Console, quality y scheduler en un solo lugar.</p>
						</div>
						<div class="rounded-[1.35rem] border border-base-300/70 bg-base-100 p-4 shadow-[var(--pi-shadow-card-soft)]">
							<div class="text-[11px] uppercase tracking-[0.22em] opacity-55">Tema activo</div>
							<div class="mt-2 text-lg font-semibold">Runtime visual</div>
							<p class="mt-1 text-sm leading-6 opacity-70">Color, tipografía y superficies viven en <code>DESIGN.md</code>.</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="grid gap-4 xl:grid-cols-4">
			<a class="group rounded-[1.4rem] border border-base-300/70 bg-base-100/80 p-5 shadow-[var(--pi-shadow-card-soft)] backdrop-blur transition-all duration-200 hover:-translate-y-0.5 hover:bg-base-100" href="/editor-view">
				<div class="text-[11px] uppercase tracking-[0.22em] opacity-55">Console</div>
				<h2 class="mt-2 text-lg font-semibold group-hover:text-primary">Consola</h2>
				<p class="mt-2 text-sm leading-6 opacity-70">Continúa tu flujo de trabajo principal.</p>
			</a>
			<a class="group rounded-[1.4rem] border border-base-300/70 bg-base-100/80 p-5 shadow-[var(--pi-shadow-card-soft)] backdrop-blur transition-all duration-200 hover:-translate-y-0.5 hover:bg-base-100" href="/report/tests">
				<div class="text-[11px] uppercase tracking-[0.22em] opacity-55">Quality</div>
				<h2 class="mt-2 text-lg font-semibold group-hover:text-primary">Calidad</h2>
				<p class="mt-2 text-sm leading-6 opacity-70">Revisa tests y cobertura del proyecto.</p>
			</a>
			<a class="group rounded-[1.4rem] border border-base-300/70 bg-base-100/80 p-5 shadow-[var(--pi-shadow-card-soft)] backdrop-blur transition-all duration-200 hover:-translate-y-0.5 hover:bg-base-100" href="/scheduler/jobs">
				<div class="text-[11px] uppercase tracking-[0.22em] opacity-55">Scheduler</div>
				<h2 class="mt-2 text-lg font-semibold group-hover:text-primary">Jobs</h2>
				<p class="mt-2 text-sm leading-6 opacity-70">Explora la configuración disponible.</p>
			</a>
			<a class="group rounded-[1.4rem] border border-base-300/70 bg-base-100/80 p-5 shadow-[var(--pi-shadow-card-soft)] backdrop-blur transition-all duration-200 hover:-translate-y-0.5 hover:bg-base-100" href="/design">
				<div class="text-[11px] uppercase tracking-[0.22em] opacity-55">Design system</div>
				<h2 class="mt-2 text-lg font-semibold group-hover:text-primary">Tema</h2>
				<p class="mt-2 text-sm leading-6 opacity-70">Inspecciona el sistema visual activo.</p>
			</a>
		</section>
	</div>
}
