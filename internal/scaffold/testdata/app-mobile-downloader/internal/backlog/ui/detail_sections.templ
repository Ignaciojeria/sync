package ui

// detailBodySections renderiza el body partido en tramos. Cada
// tramo es markdown crudo (sin los headings) listo para pasarlo por
// goldmark + bluemonday. Si una sección está vacía, no se renderiza.
//
// Los tramos en orden son:
//   1. preamble: lo que está antes de la primera sección reconocida.
//   2. plan:     contenido bajo "# Plan" (o "# Plan de trabajo").
//   3. criteria: contenido bajo "# Acceptance Criteria".
//   4. links:    contenido bajo "# Links".
//   5. tail:     lo que queda después de las secciones extraídas.
//
// Plan, criterios y links se renderizan como alertas destacadas
// (alert-warning, alert-success, alert-info) en ese orden, para que
// la lectura vertical sea: contexto → qué voy a hacer → cómo lo
// verifico → con quién se relaciona.
templ detailBodySections(preamble, plan, criteria, links, tail string) {
	if preamble != "" {
		<div class="backlog-detail-body text-sm leading-relaxed text-base-content/85 [&_h1]:text-base [&_h1]:font-semibold [&_h1]:mt-3 [&_h1]:mb-1.5 [&_h2]:text-[15px] [&_h2]:font-semibold [&_h2]:mt-3 [&_h2]:mb-1.5 [&_h3]:text-sm [&_h3]:font-semibold [&_h3]:mt-2 [&_h3]:mb-1 [&_p]:my-1.5 [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:my-1.5 [&_ol]:list-decimal [&_ol]:pl-5 [&_ol]:my-1.5 [&_li]:my-0.5 [&_a]:text-primary [&_a]:underline [&_a]:break-all [&_strong]:font-semibold [&_em]:italic [&_code]:bg-base-200 [&_code]:px-1 [&_code]:rounded [&_code]:font-mono [&_code]:text-[12px] [&_pre]:bg-base-200 [&_pre]:p-2 [&_pre]:rounded [&_pre]:overflow-x-auto [&_pre]:font-mono [&_pre]:text-[12px] [&_pre]:my-1.5 [&_pre_code]:bg-transparent [&_pre_code]:p-0 [&_blockquote]:border-l-2 [&_blockquote]:border-base-300 [&_blockquote]:pl-2 [&_blockquote]:italic [&_blockquote]:text-base-content/75 [&_blockquote]:my-1.5 [&_hr]:border-0 [&_hr]:border-t [&_hr]:border-base-300/60 [&_hr]:my-3 [&_table]:w-full [&_th]:text-left [&_th]:font-semibold [&_td]:align-top">
			@templ.Raw(RenderMarkdown(preamble))
		</div>
	}
	if plan != "" {
		@detailHighlightSection("Plan", "alert-warning", plan)
	}
	if criteria != "" {
		@detailHighlightSection("Acceptance Criteria", "alert-success", criteria)
	}
	if links != "" {
		@detailHighlightSection("Links", "alert-info", links)
	}
	if tail != "" {
		<div class="backlog-detail-body text-sm leading-relaxed text-base-content/85 [&_h1]:text-base [&_h1]:font-semibold [&_h1]:mt-3 [&_h1]:mb-1.5 [&_h2]:text-[15px] [&_h2]:font-semibold [&_h2]:mt-3 [&_h2]:mb-1.5 [&_h3]:text-sm [&_h3]:font-semibold [&_h3]:mt-2 [&_h3]:mb-1 [&_p]:my-1.5 [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:my-1.5 [&_ol]:list-decimal [&_ol]:pl-5 [&_ol]:my-1.5 [&_li]:my-0.5 [&_a]:text-primary [&_a]:underline [&_a]:break-all [&_strong]:font-semibold [&_em]:italic [&_code]:bg-base-200 [&_code]:px-1 [&_code]:rounded [&_code]:font-mono [&_code]:text-[12px] [&_pre]:bg-base-200 [&_pre]:p-2 [&_pre]:rounded [&_pre]:overflow-x-auto [&_pre]:font-mono [&_pre]:text-[12px] [&_pre]:my-1.5 [&_pre_code]:bg-transparent [&_pre_code]:p-0 [&_blockquote]:border-l-2 [&_blockquote]:border-base-300 [&_blockquote]:pl-2 [&_blockquote]:italic [&_blockquote]:text-base-content/75 [&_blockquote]:my-1.5 [&_hr]:border-0 [&_hr]:border-t [&_hr]:border-base-300/60 [&_hr]:my-3 [&_table]:w-full [&_th]:text-left [&_th]:font-semibold [&_td]:align-top">
			@templ.Raw(RenderMarkdown(tail))
		</div>
	}
}

templ detailHighlightSection(label string, alertClass string, content string) {
	<section class={ "alert " + alertClass + " items-start gap-3 rounded-box border border-current/10 text-sm" }>
		<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
			if alertClass == "alert-success" {
				<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
			} else if alertClass == "alert-warning" {
				<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 0 1 0 3.75H5.625a1.875 1.875 0 0 1 0-3.75Z"/>
			} else {
				<path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244"/>
			}
		</svg>
		<div class="flex-1 min-w-0">
			<h2 class="font-semibold text-[15px] mb-1.5 flex items-center gap-2">
				<span class="text-[10px] uppercase tracking-[0.18em] opacity-75 font-semibold">Sección</span>
				<span>{ label }</span>
			</h2>
			<div class="text-sm leading-relaxed [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:my-1 [&_ol]:list-decimal [&_ol]:pl-5 [&_ol]:my-1 [&_li]:my-0.5 [&_a]:underline [&_code]:bg-base-100 [&_code]:px-1 [&_code]:rounded [&_code]:font-mono [&_code]:text-[12px] [&_p]:my-1 [&_strong]:font-semibold">
				@templ.Raw(RenderMarkdown(content))
			</div>
		</div>
	</section>
}
