package layout

templ LayoutWithNav(title string, nav NavigationContext) {
	<!DOCTYPE html>
	<html lang="es" data-theme={ nav.ActiveThemeID }>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<script src="https://unpkg.com/htmx.org@2.0.4" crossorigin="anonymous"></script>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
			<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Public+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"/>
			<link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css"/>
			<link href={ nav.ThemeCSSHref } rel="stylesheet" type="text/css"/>
			<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
			<style>
				html, body {
					font-family: var(--pi-font-body-family, Inter, system-ui, sans-serif);
					font-size: var(--pi-font-body-size, 16px);
					font-weight: var(--pi-font-body-weight, 400);
					line-height: var(--pi-font-body-line-height, 1.5);
				}
				body {
					background:
						radial-gradient(circle at top left, color-mix(in srgb, var(--color-primary) 10%, transparent), transparent 24%),
						linear-gradient(180deg, var(--color-base-100), var(--pi-surface-muted, var(--color-base-200)) 135%);
				}
				h1, h2, h3, h4, h5, h6, .card-title, .navbar .text-lg, .menu-title {
					font-family: var(--pi-font-label-family, var(--pi-font-body-family, Inter, system-ui, sans-serif));
				}
				.menu-title, .label-text, .btn, .badge, nav, aside {
					font-family: var(--pi-font-label-family, var(--pi-font-body-family, Inter, system-ui, sans-serif));
					font-size: var(--pi-font-label-size, 0.875rem);
					font-weight: var(--pi-font-label-weight, 600);
				}
				code, pre, kbd {
					font-family: var(--pi-font-code-family, "JetBrains Mono", monospace);
					font-size: var(--pi-font-code-size, 0.875rem);
				}
				.card, .mockup-window, .stats, .alert, .table, .input, .select, .textarea {
					border-color: var(--pi-border-subtle, color-mix(in srgb, var(--color-base-content) 10%, transparent));
				}
				.card, .stats, .mockup-window {
					box-shadow: var(--pi-shadow-card-soft, 0 10px 28px -18px color-mix(in srgb, var(--color-base-content) 18%, transparent));
				}
				.drawer-side {
					overflow-y: visible !important;
					max-height: none !important;
				}
				.drawer-side > *:not(.drawer-overlay) {
					overflow-y: visible !important;
				}
				.pi-sidebar-shell {
					background: linear-gradient(180deg, color-mix(in srgb, var(--color-base-200) 88%, transparent), color-mix(in srgb, var(--color-base-300) 72%, transparent));
					border-right: 1px solid var(--pi-border-subtle, color-mix(in srgb, var(--color-base-content) 9%, transparent));
					box-shadow: var(--pi-shadow-sidebar, 0 20px 45px -30px color-mix(in srgb, var(--color-base-content) 28%, transparent));
					backdrop-filter: blur(12px);
				}
				.pi-sidebar-panel {
					padding: 0.375rem;
				}
				.pi-main-surface {
					padding-top: clamp(1rem, 1rem + 1vw, 1.75rem);
					padding-bottom: clamp(1.25rem, 1.25rem + 1vw, 2.25rem);
				}
				/* Gmail-like mobile drawer: smooth, finger-following slide */
				@media (max-width: 1023px) {
					.drawer-side > .pi-sidebar-shell {
						will-change: transform;
						transition: transform 0.28s cubic-bezier(0.32, 0.72, 0, 1);
					}
					.drawer-side > .drawer-overlay {
						transition: opacity 0.28s cubic-bezier(0.32, 0.72, 0, 1);
					}
					/* left-edge affordance to catch the opening swipe */
					.pi-edge-swipe {
						position: fixed;
						top: 0;
						left: 0;
						width: 24px;
						height: 100vh;
						z-index: 30;
						touch-action: pan-y;
					}
				}
				@media (min-width: 1024px) {
					.pi-edge-swipe { display: none; }
				}
			</style>
		</head>
		<body class="min-h-screen bg-base-100 text-base-content antialiased">
		<div class="drawer lg:drawer-open min-h-screen">
			<input id="nav-drawer" type="checkbox" class="drawer-toggle"/>
			<div class="pi-edge-swipe lg:hidden" aria-hidden="true"></div>
			<div class="drawer-content flex flex-col min-h-screen">
				<div class="navbar bg-base-100/80 backdrop-blur lg:hidden border-b border-base-200">
					<label for="nav-drawer" class="btn btn-square btn-ghost drawer-button">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
					</label>
					<span class="text-lg font-semibold">{ title }</span>
				</div>
				<main class="pi-main-surface p-4 md:p-6 flex-1 min-h-0 flex flex-col">
					{ children... }
				</main>
			</div>
			<div class="drawer-side">
				<label for="nav-drawer" class="drawer-overlay"></label>
				<div class="pi-sidebar-shell h-full flex flex-col min-h-0">
					<input type="checkbox" id="sidebar-collapse" class="peer sr-only"/>
					<div class="flex items-center gap-2 px-2.5 py-2.5 border-b border-base-300/60">
						<div class="hidden flex-1 peer-checked:flex items-center justify-center">
							<div class="flex h-7 w-7 items-center justify-center rounded-full border border-base-300/60 bg-base-100/70 text-[10px] font-semibold tracking-[0.24em] text-base-content/78">S4</div>
						</div>
						<div class="flex min-w-0 flex-1 items-center justify-center peer-checked:hidden">
							<div class="flex items-baseline gap-1.5 text-[1.08rem] font-semibold leading-none tracking-[0.015em] text-base-content/80" style="font-family: var(--pi-font-label-family, var(--pi-font-body-family, Inter, system-ui, sans-serif));">
								<span>sync</span>
								<span><span class="text-primary text-[1.08em] font-medium tracking-[-0.08em]">4</span><span class="text-primary">.</span></span>
								<span>run</span>
							</div>
						</div>
						<label for="sidebar-collapse" class="btn btn-ghost btn-xs btn-square shrink-0 cursor-pointer">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 transition-transform peer-checked:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
						</label>
					</div>
					<div class="pi-sidebar-panel w-44 peer-checked:w-14 transition-all duration-300 overflow-hidden flex-1 min-h-0">
						@SideNav(nav)
					</div>
				</div>
			</div>
		</div>
		<script>
			(function () {
				var toggle = document.getElementById('nav-drawer');
				var side = document.querySelector('.drawer-side');
				if (!toggle || !side) return;
				var overlay = side.querySelector('.drawer-overlay');
				var panel = side.querySelector('.pi-sidebar-shell');
				if (!panel) return;

				var EDGE = 28;          // px from the left edge that starts an opening swipe
				var ANGLE = 8;          // px of movement before we lock the drag axis
				var isMobile = function () { return window.matchMedia('(max-width: 1023px)').matches; };

				var width = 176, startX = 0, startY = 0, dx = 0;
				var mode = null;        // 'open' | 'close'
				var axis = null;        // 'x' | 'y'

				function beginDrag() {
					width = panel.offsetWidth || width;
					panel.style.transition = 'none';
					if (overlay) overlay.style.transition = 'none';
				}

				function moveTo(tx) {
					tx = Math.max(-width, Math.min(0, tx));
					panel.style.transform = 'translateX(' + tx + 'px)';
					if (overlay) overlay.style.opacity = String(1 + tx / width);
				}

				function endDrag(open) {
					toggle.checked = open;
					panel.style.transition = '';
					if (overlay) overlay.style.transition = '';
					requestAnimationFrame(function () {
						panel.style.transform = '';
						if (overlay) overlay.style.opacity = '';
					});
				}

				document.addEventListener('touchstart', function (e) {
					if (!isMobile() || e.touches.length !== 1) { mode = null; return; }
					var t = e.touches[0];
					startX = t.clientX; startY = t.clientY; axis = null; dx = 0;
					if (!toggle.checked && startX <= EDGE) mode = 'open';
					else if (toggle.checked) mode = 'close';
					else mode = null;
				}, { passive: true });

				document.addEventListener('touchmove', function (e) {
					if (!mode || e.touches.length !== 1) return;
					var t = e.touches[0];
					var mx = t.clientX - startX, my = t.clientY - startY;
					if (axis === null) {
						if (Math.abs(mx) < ANGLE && Math.abs(my) < ANGLE) return;
						axis = Math.abs(mx) > Math.abs(my) ? 'x' : 'y';
						if (axis === 'x') beginDrag(); else { mode = null; return; }
					}
					if (axis !== 'x') return;
					e.preventDefault();
					dx = mx;
					moveTo(mode === 'open' ? -width + mx : mx);
				}, { passive: false });

				function release() {
					if (!mode) return;
					if (axis === 'x') {
						var threshold = width * 0.35;
						if (mode === 'open') endDrag(dx > threshold);
						else endDrag(dx > -threshold);
					}
					mode = null; axis = null; dx = 0;
				}
				document.addEventListener('touchend', release);
				document.addEventListener('touchcancel', release);
			})();
		</script>
		</body>
	</html>
}
