package layout

import "strings"

type PreviewMergeBarState struct {
	Active    bool
	SessionID string
	// BackURL es el destino del botón "Back to agent". Construido
	// server-side (en preview_context_ui.go) usando mounted.Host
	// para que apunte al chat del agente en el host y NO adentro
	// del mount del preview — el botón homónimo del chat usa el
	// mismo criterio via hostAgentSessionURL.
	BackURL string
	// NoChanges aplica sólo cuando Success=true. Indica que el
	// merge se ejecutó correctamente pero la rama de preview no
	// tenía commits nuevos para integrar (preview-branch == base
	// o preview totalmente mergeado en base). El bar muestra un
	// estado neutro ("Up to date") y el handler no crea sesión
	// nueva en este caso.
	NoChanges      bool
	BaseBranch     string
	PreviewBranch  string
	Applicable     bool
	ActionPath     string
	ErrorMessage   string
	Success        bool
}

templ PreviewMergeBar(state PreviewMergeBarState) {
	if !state.Active {
		<div id="global-preview-merge-bar"></div>
	} else {
		<div id="global-preview-merge-bar" class="fixed inset-x-0 bottom-0 z-40 border-t border-base-300/60 bg-base-100/92 backdrop-blur">
			<div class="mx-auto flex max-w-screen-2xl items-center gap-3 px-4 py-1.5 text-xs">
				<span class={ previewMergeBarBadgeClass(state) }>{ previewMergeBarBadge(state) }></span>
				<span class="flex-1 truncate text-base-content/84">{ previewMergeBarMessage(state) }></span>
				<div class="flex shrink-0 items-center gap-2">
					if strings.TrimSpace(state.BackURL) != "" {
						<a class="btn btn-xs btn-ghost" href={ templ.SafeURL(state.BackURL) }>Back to agent</a>
					}
					if state.Applicable && strings.TrimSpace(state.ErrorMessage) == "" && !state.Success {
						<button
							class="btn btn-xs btn-primary"
							hx-post={ state.ActionPath }
							hx-target="#global-preview-merge-bar"
							hx-swap="outerHTML"
							hx-confirm={ previewMergeConfirm(state) }>
							Merge preview
						</button>
					}
				</div>
			</div>
		</div>
	}
}

func previewMergeBarTone(state PreviewMergeBarState) string {
	if strings.TrimSpace(state.ErrorMessage) != "" {
		return "text-error"
	}
	if state.Success {
		if state.NoChanges {
			return "text-base-content"
		}
		return "text-success"
	}
	return "text-base-content"
}

func previewMergeBarBadgeClass(state PreviewMergeBarState) string {
	if strings.TrimSpace(state.ErrorMessage) != "" {
		return "badge badge-error badge-sm"
	}
	if state.Success && !state.NoChanges {
		return "badge badge-success badge-sm"
	}
	// success + no changes, o estado neutral (apenas cargada la
	// preview, sin click todavía): ambos usan tono info para no
	// sugerir éxito falso ni error.
	return "badge badge-info badge-sm"
}

func previewMergeBarBadge(state PreviewMergeBarState) string {
	if strings.TrimSpace(state.ErrorMessage) != "" {
		return "Blocked"
	}
	if state.Success {
		if state.NoChanges {
			return "Up to date"
		}
		return "Applied"
	}
	return "Preview"
}

func previewMergeBarMessage(state PreviewMergeBarState) string {
	if msg := strings.TrimSpace(state.ErrorMessage); msg != "" {
		return msg
	}
	if state.Success {
		if state.NoChanges {
			return "No hay cambios nuevos para mergear."
		}
		if strings.TrimSpace(state.BaseBranch) != "" {
			return "Cambios aplicados a " + state.BaseBranch + "."
		}
		return "Cambios aplicados."
	}
	return "Preview aislada: lo que veas aquí no se aplica al workspace base."
}

func previewMergeConfirm(state PreviewMergeBarState) string {
	preview := strings.TrimSpace(state.PreviewBranch)
	base := strings.TrimSpace(state.BaseBranch)
	if preview != "" && base != "" {
		return "Esto va a mergear la rama " + preview + " en " + base + " (no fast-forward). Si la preview no tiene cambios, no se creará un commit."
	}
	if preview != "" {
		return "Esto va a mergear la rama " + preview + " en el branch base (no fast-forward)."
	}
	return "Esto va a mergear la preview en el branch base."
}
