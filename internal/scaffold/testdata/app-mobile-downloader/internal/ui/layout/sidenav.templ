package layout

import (
	designui "gitinittest5/internal/design/ui"
	"strings"
)

templ SideNav(nav NavigationContext) {
	<ul class="menu menu-sm p-1.5 gap-1 w-full h-full flex flex-col text-base-content/90">
		<li class="menu-title text-[9px] uppercase tracking-[0.22em] opacity-55 mt-1 px-2 group-has-checked:hidden">App</li>
		<li>
			<a class={ navItemBaseClass() + " " + navItemToneClass("/", nav.CurrentPath) + " " + navItemClass("/", nav.CurrentPath) } href={ nav.AppPath("/") }>
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
				<span class="group-has-checked:hidden">Inicio</span>
			</a>
		</li>

		if nav.IsEditor {
			<li class="menu-title text-[9px] uppercase tracking-[0.22em] opacity-55 mt-3 px-2 group-has-checked:hidden">development</li>
			<li>
				<a class={ navItemBaseClass() + " " + navItemToneClass("/editor-view", nav.CurrentPath) + " " + navItemClass("/editor-view", nav.CurrentPath) } href={ nav.AppPath("/editor-view") }>
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
					<span class="group-has-checked:hidden">Console</span>
				</a>
			</li>
			<li>
				<a class={ navItemBaseClass() + " " + navItemToneClass("/agent", nav.CurrentPath) + " " + navItemClass("/agent", nav.CurrentPath) } href={ nav.AppPath("/agent") }>
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3v2.25M14.25 3v2.25M4.5 9h15M5.25 19.5h13.5A2.25 2.25 0 0 0 21 17.25V8.25A2.25 2.25 0 0 0 18.75 6H5.25A2.25 2.25 0 0 0 3 8.25v9A2.25 2.25 0 0 0 5.25 19.5ZM9 14.25h.008v.008H9v-.008Zm3 0h.008v.008H12v-.008Zm3 0h.008v.008H15v-.008Z"/></svg>
					<span class="group-has-checked:hidden">Agent</span>
				</a>
			</li>
			<li>
				<a class={ navItemBaseClass() + " " + navItemToneClass("/report/tests", nav.CurrentPath) + " " + navItemClass("/report/tests", nav.CurrentPath) } href={ nav.AppPath("/report/tests") }>
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
					<span class="group-has-checked:hidden">Quality</span>
				</a>
			</li>
			<li>
				<a class={ navItemBaseClass() + " " + navItemToneClass("/backlog", nav.CurrentPath) + " " + navItemClass("/backlog", nav.CurrentPath) } href={ nav.AppPath("/backlog") }>
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7M14 6h6M14 12h6M14 18h6"/></svg>
					<span class="group-has-checked:hidden">Backlog</span>
				</a>
			</li>
			<li>
				<a class={ navItemBaseClass() + " " + navItemToneClass("/versions", nav.CurrentPath) + " " + navItemClass("/versions", nav.CurrentPath) } href={ nav.AppPath("/versions") }>
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
					<span class="group-has-checked:hidden">Versiones</span>
				</a>
			</li>
			<li>
				<a class={ navItemBaseClass() + " " + navItemToneClass("/scheduler/jobs", nav.CurrentPath) + " " + navItemClass("/scheduler/jobs", nav.CurrentPath) } href={ nav.AppPath("/scheduler/jobs") }>
					<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
					<span class="group-has-checked:hidden">Scheduler</span>
				</a>
			</li>
		}

		if len(nav.Themes) > 0 {
			@designui.Panel(nav.Themes, nav.ActiveTheme, nav.PreviewPrefix)
		}

		<li class="mt-auto"></li>
		<li>
			<div
				id="gateway-balance"
				hx-get={ nav.HostPath("/gateway/balance") }
				hx-trigger="load, every 60s"
				hx-swap="innerHTML"
			>
				<div class="rounded-box bg-base-100/40 border border-base-300/40 px-3 py-2 mt-3 group-has-checked:hidden">
					<div class="text-[9px] uppercase tracking-[0.22em] opacity-40">Balance</div>
					<div class="flex items-baseline gap-1 mt-0.5">
						<span class="text-sm opacity-50">…</span>
					</div>
				</div>
			</div>
		</li>
		<li>
			<a class="rounded-box px-2 py-1.75 text-[13px] text-error transition-colors hover:bg-error/10 hover:text-error" href={ nav.AppPath("/auth/logout") }>
				<svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
				<span class="group-has-checked:hidden">Cerrar sesion</span>
			</a>
		</li>
	</ul>
}

func navItemBaseClass() string {
	return "rounded-box px-2 py-1.75 text-[13px] transition-all duration-200 hover:bg-base-100/70 border border-transparent"
}

func navItemToneClass(base, current string) string {
	if current == base || strings.HasPrefix(current, base+"/") {
		return "bg-base-100/92 text-base-content border-base-300/60"
	}
	return "text-base-content/68"
}

func navItemClass(base, current string) string {
	if current == base || strings.HasPrefix(current, base+"/") {
		return "active"
	}
	return ""
}
