package ui

templ StandalonePage(state PageState, themeID string, themeCSSHref string) {
	<!DOCTYPE html>
	<html lang="es" data-theme={ themeID }>
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="color-scheme" content="light dark"/>
			<title>Agent</title>
			<script src="https://unpkg.com/htmx.org@2.0.4" crossorigin="anonymous"></script>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
			<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet"/>
			<link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css"/>
			<link href={ themeCSSHref } rel="stylesheet" type="text/css"/>
			<script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
			<style>
				html {
					color-scheme: light dark;
					font-family: var(--pi-font-body-family, Inter, system-ui, sans-serif);
					font-size: var(--pi-font-body-size, 16px);
					font-weight: var(--pi-font-body-weight, 400);
					line-height: var(--pi-font-body-line-height, 1.5);
					accent-color: var(--color-primary);
					scrollbar-width: thin;
					scrollbar-color: var(--pi-border-subtle) transparent;
				}
				html, body {
					height: 100%;
					overflow: hidden;
				}
				/* Background del agente: un solo color base por tema.
				 * Forest (oscuro) usa base-200 para que no quede tan
				 * negro como base-100; los temas claros (Ocean/Sunset)
				 * usan base-100 para que la superficie quede realmente
				 * blanca en vez de gris plomo. */
				body {
					margin: 0;
					background-color: var(--color-base-200);
				}
				[data-theme="ocean"] body,
				[data-theme="sunset"] body {
					background-color: var(--color-base-100);
				}
				h1, h2, h3, h4, h5, h6, .card-title, .btn, .badge {
					font-family: var(--pi-font-label-family, var(--pi-font-body-family, Inter, system-ui, sans-serif));
				}
				code, pre, textarea, input {
					font-family: var(--pi-font-code-family, "JetBrains Mono", monospace);
				}
				.card, .alert, .input, .textarea {
					border-color: var(--pi-border-subtle);
				}
				.agent-glass-panel {
					background-color: var(--pi-surface-elevated);
				}
				.agent-glass-panel-soft {
					background-color: var(--pi-surface-muted);
				}
				.agent-shell-border {
					border-color: var(--pi-border-subtle);
				}
				.agent-shell-shadow {
					box-shadow: var(--pi-shadow-card);
				}
				.agent-shell-shadow-strong {
					box-shadow: var(--pi-shadow-sidebar);
				}
				.agent-raised {
					box-shadow: var(--pi-shadow-card-soft);
				}
				.agent-thin-scroll {
					scrollbar-gutter: stable;
				}
				.agent-thin-scroll::-webkit-scrollbar {
					width: 10px;
					height: 10px;
				}
				.agent-thin-scroll::-webkit-scrollbar-thumb {
					background: var(--pi-border-subtle);
					border-radius: 999px;
				}
				.agent-thin-scroll::-webkit-scrollbar-track {
					background: transparent;
				}
				/* Indicador de carga: tres puntos animados en cascada
				 * dentro de una burbuja chat del lado izquierdo del
				 * asistente. */
				.thinking-dot {
					display: inline-block;
					width: 0.55em;
					height: 0.55em;
					border-radius: 999px;
					background-color: currentColor;
					opacity: 0.5;
					animation: pi-thinking 1.2s infinite ease-in-out;
				}
				.thinking-dot:nth-child(2) {
					animation-delay: 150ms;
				}
				.thinking-dot:nth-child(3) {
					animation-delay: 300ms;
				}
				@keyframes pi-thinking {
					0%, 60%, 100% {
						opacity: 0.5;
						transform: translateY(0);
					}
					30% {
						opacity: 1;
						transform: translateY(-0.22em);
					}
				}
				@media (prefers-reduced-motion: reduce) {
					.thinking-dot {
						animation: none;
						opacity: 0.8;
					}
				}
				@media (prefers-reduced-motion: reduce) {
					* {
						scroll-behavior: auto;
					}
				}
			</style>
		</head>
		<body class="h-screen text-base-content antialiased">
			@Page(state)
		</body>
	</html>
}
