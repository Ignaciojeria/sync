package ui

templ ProvidersPage(state PageState) {
	<div class="min-h-screen">
		<div class="mx-auto flex min-h-screen w-full max-w-5xl flex-col px-4 py-4 sm:px-5 sm:py-5 xl:min-h-0">
			<header class="agent-glass-panel agent-shell-shadow rounded-[1.5rem] border agent-shell-border px-4 py-4 sm:px-5">
				<div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
					<div class="space-y-2">
						<div class="badge badge-ghost badge-sm uppercase tracking-[0.22em]">Integraciones</div>
						<h1 class="text-2xl font-semibold tracking-tight text-base-content sm:text-[2rem]" style="font-family: var(--pi-font-label-family, var(--pi-font-body-family, Inter, system-ui, sans-serif));">Login</h1>
						<p class="max-w-2xl text-sm leading-6 text-base-content/72 sm:text-[0.95rem]">Por ahora dejamos una sola superficie para proveedores externos. La recomendación sigue siendo usar tu gateway o una API key de proyecto, no login humano desde la VM.</p>
					</div>
					<a class="btn btn-ghost btn-sm sm:btn-md" href={ appPath(state, "/agent") }>Volver al dashboard</a>
				</div>
			</header>

			<main class="grid flex-1 gap-4 py-4 lg:grid-cols-[minmax(0,1.25fr)_minmax(18rem,0.75fr)]">
				<section class="card border border-base-300/70 bg-base-100/86 shadow-[var(--pi-shadow-card-soft)]">
					<div class="card-body gap-5 p-5 sm:p-6">
						<div class="space-y-2">
							<div class="flex items-center gap-2">
								<h2 class="card-title text-lg">Login con OpenAI vía gateway</h2>
								<span class="badge badge-ghost badge-sm">recomendado</span>
							</div>
							<p class="text-sm leading-6 text-base-content/70">Mantén la credencial real fuera de esta VM y enruta el tráfico por tu gateway. Menos riesgo, mejor rotación y métricas centralizadas.</p>
						</div>
						<div class="rounded-box border border-base-300/60 bg-base-100/70 p-4">
							<div class="flex flex-wrap items-center justify-between gap-3">
								<div>
									<div class="text-[0.72rem] uppercase tracking-[0.22em] text-base-content/54">Estado</div>
									<div class="mt-1 text-sm text-base-content/80">Balance detectado desde el gateway configurado</div>
								</div>
								<div id="providers-balance" hx-get={ appPath(state, "/gateway/balance") } hx-trigger="load, every 60s" hx-swap="innerHTML">
									<div class="badge badge-ghost badge-sm border-base-300/60 text-base-content/54">…</div>
								</div>
							</div>
						</div>
						<div class="grid gap-3 sm:grid-cols-2">
							<div class="rounded-box border border-base-300/60 bg-base-100/60 p-4">
								<div class="text-[0.72rem] uppercase tracking-[0.22em] text-base-content/52">Camino corto</div>
								<p class="mt-2 text-sm leading-6 text-base-content/74">Configura <code>OPENAI_API_KEY</code> o apunta al gateway y listo.</p>
							</div>
							<div class="rounded-box border border-base-300/60 bg-base-100/60 p-4">
								<div class="text-[0.72rem] uppercase tracking-[0.22em] text-base-content/52">Después</div>
								<p class="mt-2 text-sm leading-6 text-base-content/74">Si luego quieres OAuth/device flow, se agrega cuando el proveedor lo soporte de verdad.</p>
							</div>
						</div>
						<div class="card-actions justify-start">
							<a class="btn btn-primary" href={ appPath(state, "/agent") }>Abrir chat</a>
							<a class="btn btn-ghost" href={ appPath(state, "/") }>Ver dashboard general</a>
						</div>
					</div>
				</section>

				<aside class="space-y-4">
					<div class="card border border-base-300/70 bg-base-100/86 shadow-[var(--pi-shadow-card-soft)]">
						<div class="card-body p-5">
							<h2 class="card-title text-base">Siguiente paso útil</h2>
							<ul class="menu menu-sm w-full rounded-box bg-base-100/40 p-0 text-sm">
								<li><span>Exponer proveedor activo en badges del chat</span></li>
								<li><span>Agregar selector de modelo</span></li>
								<li><span>Reemplazar esta vista por settings reales cuando exista storage</span></li>
							</ul>
						</div>
					</div>
					<div class="card border border-base-300/70 bg-base-100/86 shadow-[var(--pi-shadow-card-soft)]">
						<div class="card-body p-5">
							<h2 class="card-title text-base">Comandos que siguen sirviendo</h2>
							<div class="space-y-2 text-sm text-base-content/74" style="font-family: var(--pi-font-code-family, 'JetBrains Mono', monospace);">
								<div class="rounded-box border border-base-300/60 bg-base-100/50 px-3 py-2">/login openai</div>
								<div class="rounded-box border border-base-300/60 bg-base-100/50 px-3 py-2">/providers</div>
								<div class="rounded-box border border-base-300/60 bg-base-100/50 px-3 py-2">/model &lt;id&gt;</div>
							</div>
						</div>
					</div>
				</aside>
			</main>
		</div>

	</div>
}
